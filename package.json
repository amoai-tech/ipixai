{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "echo 'DEV-STAB-001: run npm run dev:ui and npm run dev:agent separately until the combined watcher storm is fixed' && exit 1",
    "dev:agent": "node scripts/dev-guard.mjs --port 4111 -- mastra dev",
    "dev:ui": "node scripts/dev-guard.mjs --port 3000 -- next dev --turbopack",
    "dev:debug": "LOG_LEVEL=debug npm run dev:ui",
    "build": "node scripts/dev-guard.mjs --port 3000 --port 4111 -- next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:design": "vitest run src/components/ui/empty-state.test.tsx src/components/ui/error-state.test.tsx src/components/ui/entity-list.test.tsx src/components/ui/status-chip.test.tsx",
    "channel": "tsx --tsconfig tsconfig.channel.json channel-host.mts",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "e2e:headed": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --headed",
    "e2e:debug": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --debug",
    "e2e:report": "PLAYWRIGHT_BROWSERS_PATH=0 playwright show-report",
    "e2e:production": "E2E_PRODUCTION_SMOKE=1 PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config=playwright.production.config.ts",
    "dev:e2e": "node scripts/dev-guard.mjs --port 3015 -- next dev --turbopack -p 3015",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.58",
    "@ag-ui/mastra": "1.1.2",
    "@ai-sdk/openai": "^2.0.42",
    "@copilotkit/channels": "0.9.0",
    "@copilotkit/react-core": "1.68.1",
    "@copilotkit/runtime": "1.68.1",
    "@libsql/client": "^0.15.15",
    "@mastra/client-js": "1.42.4",
    "@mastra/core": "1.63.2",
    "@mastra/libsql": "1.22.2",
    "@mastra/memory": "1.28.1",
    "@mastra/pg": "1.22.2",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "hono": "^4",
    "libsql": "^0.5.22",
    "lucide-react": "^0.525.0",
    "mastra": "1.27.2",
    "next": "16.1.2",
    "next-cloudinary": "^6.18.8",
    "pg": "8.23.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@ag-ui/client": "0.0.58",
    "@ag-ui/core": "0.0.58",
    "@ag-ui/encoder": "0.0.58",
    "@ag-ui/proto": "0.0.58"
  }
}
