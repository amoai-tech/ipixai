{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "echo 'DEV-STAB-001: run npm run dev:ui and npm run dev:agent separately until the combined watcher storm is fixed' && exit 1",
    "dev:agent": "dotenvx run --convention=nextjs -- node scripts/dev-guard.mjs --port 4111 -- mastra dev",
    "dev:ui": "node scripts/dev-guard.mjs --port 3000 -- next dev --turbopack",
    "dev:debug": "LOG_LEVEL=debug npm run dev:ui",
    "build": "node scripts/dev-guard.mjs --port 3000 --port 4111 -- next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "secrets:check": "node scripts/check-local-secrets.mjs",
    "secrets:protect": "dotenvx protect",
    "pretest": "npm run secrets:check",
    "supabase:types": "supabase db reset --local --no-seed && node scripts/generate-supabase-types.mjs",
    "supabase:types:check": "node scripts/generate-supabase-types.mjs --check",
    "test": "vitest run",
    "test:skills": "vitest run tests/skill-contracts.test.ts",
    "test:design": "vitest run src/components/ui/empty-state.test.tsx src/components/ui/error-state.test.tsx src/components/ui/entity-list.test.tsx src/components/ui/status-chip.test.tsx",
    "channel": "dotenvx run --convention=nextjs -- tsx --tsconfig tsconfig.channel.json channel-host.mts",
    "reference-library": "tsx scripts/reference-library/candidates.ts",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=chromium --project=mobile-chromium",
    "e2e:ai-smoke": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=chromium-ai-smoke",
    "e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=chromium --project=mobile-chromium --ui",
    "e2e:headed": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=chromium --project=mobile-chromium --headed",
    "e2e:debug": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=chromium --project=mobile-chromium --debug",
    "e2e:report": "PLAYWRIGHT_BROWSERS_PATH=0 playwright show-report",
    "e2e:production": "E2E_PRODUCTION_SMOKE=1 PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config=playwright.production.config.ts",
    "e2e:production-cert": "E2E_PRODUCTION_CERT=1 PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config=playwright.production-cert.config.ts",
    "e2e:approval": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/run-approval-001-e2e.mjs",
    "dev:e2e": "node scripts/dev-guard.mjs --port 3015 -- next dev --turbopack -p 3015",
    "start:e2e": "node scripts/dev-guard.mjs --port 3015 -- next start -p 3015",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "e2e:agents:init": "node scripts/init-playwright-test-agents.mjs",
    "e2e:agents:seed": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config=playwright.agents.config.ts --project=playwright-agent",
    "docs:check": "node scripts/check-doc-links.mjs",
    "test:coverage": "vitest run --coverage",
    "skills:registry:check": "node scripts/validate-skill-registry.mjs",
    "skills:index": "node scripts/generate-skill-index.mjs",
    "skills:vendor:baseline": "node scripts/skills-vendor-baseline.mjs --write",
    "skills:vendor:check": "node scripts/skills-vendor-baseline.mjs",
    "skills:index:check": "node scripts/generate-skill-index.mjs --check",
    "e2e:debug:cli": "PLAYWRIGHT_HTML_OPEN=never PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=chromium --debug=cli",
    "e2e:debug:cli:attach": "playwright-cli attach",
    "agent:claude": "dotenvx run -f .env.agent --strict --redact -- claude",
    "agent:codex": "dotenvx run -f .env.agent --strict --redact -- codex"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/mastra": "1.1.4",
    "@ai-sdk/openai": "^2.0.42",
    "@copilotkit/channels": "0.11.0",
    "@copilotkit/react-core": "1.73.3",
    "@copilotkit/runtime": "1.73.3",
    "@mastra/client-js": "1.50.0",
    "@mastra/core": "1.71.0",
    "@mastra/memory": "1.32.1",
    "@mastra/observability": "1.18.1",
    "@mastra/pg": "1.27.1",
    "@sentry/nextjs": "11.0.0",
    "@sentry/node": "11.0.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "lucide-react": "^0.525.0",
    "mastra": "1.31.3",
    "next": "16.4.5",
    "pg": "8.23.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.30.0",
    "@dotenvx/next-env": "2.2.3",
    "@playwright/cli": "0.1.21",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.1.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.0.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "@ag-ui/proto": "0.0.59",
    "qs": "6.16.0",
    "shell-quote": "1.12.0",
    "js-yaml": "3.15.2",
    "@next/env": "npm:@dotenvx/next-env",
    "dompurify": "3.4.17",
    "proxy-addr": "2.0.8",
    "undici": "6.29.1",
    "@fastify/busboy": "3.2.5",
    "jsdom": {
      "undici": "8.12.4"
    }
  }
}
