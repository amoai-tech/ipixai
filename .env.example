# Copy to .env locally. Never commit real keys.
OPENAI_API_KEY=
COPILOTKIT_TELEMETRY_DISABLED=true

# CopilotKit Intelligence — managed mode (IPI-1191 · COPILOT-INTEL-001).
# Server-only; never NEXT_PUBLIC_*. Provisioned by
# `npx copilotkit project select --project <your-project>` into .env
# (gitignored). COPILOTKIT_API_KEY is the accepted alias name. Do not set
# COPILOTKIT_LICENSE_TOKEN alongside this — that's a separate,
# offline/self-hosted-only credential (see README "CopilotKit Intelligence &
# Threads"). apiUrl/wsUrl default to the managed platform; only set
# INTELLIGENCE_API_URL / INTELLIGENCE_GATEWAY_WS_URL for a self-hosted target.
# CPK_INTELLIGENCE_API_KEY=

# Public Supabase Auth (browser-safe). Never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Playwright E2E QA accounts (real values belong only in .env.test / CI secrets).
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_EMAIL_ORG_B=
E2E_TEST_PASSWORD_ORG_B=

# Server-only Supabase (IPI-1111 webhook mirror). Never NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=

# Local Postgres only (opt-in). Hosts outside the allowlist are rejected.
# Copy the URI from `supabase status` after `supabase start` (CLI default is
# 127.0.0.1:54322). A local Docker publish on 54342 is also allowed.
# Omit this and Planner chat stays in RAM (LibSQL).
# MASTRA_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres

# Hosted preview/runtime (IPI-1124). Never set this locally unless you intend
# fail-closed Postgres (no LibSQL). Pair with a Dashboard URI for fashionos
# only: user hyperdrive_mastra_runtime (or user.project-ref on the pooler).
# Prefer transaction pooler port 6543; session 5432 only if transaction fails.
# IPIX_MASTRA_HOSTED=1
# MASTRA_DATABASE_URL=postgresql://hyperdrive_mastra_runtime.[PROJECT_REF]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Cloudinary (IPI-1108 · CLD-FOUNDATION-001)
# Public cloud name is ipix-cloudinary (not a secret).
# CLOUDINARY_API_SECRET is server-only — never NEXT_PUBLIC_* and never
# import src/lib/cloudinary/config.ts from Client Components.
# ai_powerstart = unsigned Cloudinary Power Start validation preset only.
# Never use ai_powerstart for production operator uploads.
# Production uploads = signed iPix flow (IPI-1110 · CLD-SIGN-001 +
# IPI-1116 · CLD-UPLOAD-001).
# Approval must never make authenticated DAM assets public.
CLOUDINARY_CLOUD_NAME=ipix-cloudinary
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Consume-only signed upload preset (IPI-1112 owns eager/named transforms).
# Defaults to ipix-signed-upload when unset. Never ai_powerstart.
CLOUDINARY_SIGNED_UPLOAD_PRESET=ipix-signed-upload
# Optional dedicated webhook verification secret (IPI-1111). Falls back to API secret.
# CLOUDINARY_NOTIFICATION_API_SECRET=

# Browser-safe (next-cloudinary). Cloud name only — no API secret.
# The sign route also returns api_key for prepareUploadParams.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=ipix-cloudinary
